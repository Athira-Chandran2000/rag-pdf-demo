# .gitattributes — Git LFS tracking for large binary data files
# Run once per machine: git lfs install
# Then: git add .gitattributes && git commit

# Processed index files (FAISS, SQLite, BM25 pickle, chunks JSON)
data/processed/faiss.index filter=lfs diff=lfs merge=lfs -text
data/processed/metadata.db  filter=lfs diff=lfs merge=lfs -text
data/processed/bm25.pkl     filter=lfs diff=lfs merge=lfs -text
data/processed/chunks.json  filter=lfs diff=lfs merge=lfs -text

# Raw PDFs (only if you choose to commit them — usually not recommended)
data/pdfs/*.pdf filter=lfs diff=lfs merge=lfs -text
